{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hera",
  "version": "0.1.2",
  "identifier": "dev.hera.dock",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Hera",
    "shortDescription": "Hera — Windows와 맥을 하나처럼",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "resources": {
      "resources/link/": "link/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMUFBRjA5RUJEMjg3ODAKUldTQWg5THJDYThhbXlQN2NmMXBDblNyd2J6WEdLSTBOQ0pGcnlWakRMSllwRnV2NEd2bWtQaDEK",
      "endpoints": [],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
